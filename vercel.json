{
  "crons": [
    {
      "path": "/api/activate-pro?action=cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/activate-pro?action=movie-alerts-cron",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth?action=:action*"
    },
    {
      "source": "/api/groq",
      "destination": "/api/ai"
    },
    {
      "source": "/api/recommend",
      "destination": "/api/ai"
    },
    {
      "source": "/api/send-thank-you-email",
      "destination": "/api/activate-pro?action=thank-you-email"
    },
    {
      "source": "/api/cron-subscriptions",
      "destination": "/api/activate-pro?action=cron"
    },
    {
      "source": "/api/movie-alerts",
      "destination": "/api/activate-pro?action=movie-alerts"
    },
    {
      "source": "/api/tmdb",
      "destination": "/api/search?action=tmdb"
    },
    {
      "source": "/api/preferences",
      "destination": "/api/search?action=preferences"
    },
    {
      "source": "/api/geo",
      "destination": "/api/saspay?action=geo"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/admin?action=feedback"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin?action=users"
    },
    {
      "source": "/api/admin/:action*",
      "destination": "/api/admin?action=:action*"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/api/paddle-webhook",
      "destination": "/api/paddle-webhook"
    },
    {
      "source": "/api/paddle/webhook",
      "destination": "/api/paddle-webhook"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/saspay?action=webhook"
    },
    {
      "source": "/api/saspay/webhook",
      "destination": "/api/saspay?action=webhook"
    },
    {
      "source": "/api/saspay/verify",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/saspay/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/saspay",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/moneroo/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/moneroo",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/notchpay/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/notchpay",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/activate-pro.js": {
      "maxDuration": 300
    },
    "api/releases.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://cdn.paddle.com https://va.vercel-scripts.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.themoviedb.org https://api.paddle.com https://sandbox-api.paddle.com https://*.paddle.com https://*.vercel-insights.com https://vercel.live https://www.omdbapi.com https://api.trakt.tv https://api.groq.com https://api.deepseek.com https://dashscope.aliyuncs.com https://api.openai.com https://api.anthropic.com https://api.x.ai; frame-src https://www.youtube-nocookie.com https://*.paddle.com https://vercel.live; form-action 'self' https://*.paddle.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
