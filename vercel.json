{
  "rewrites": [
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth?action=:action*"
    },
    {
      "source": "/api/groq",
      "destination": "/api/ai"
    },
    {
      "source": "/api/recommend",
      "destination": "/api/ai"
    },
    {
      "source": "/api/saspay/webhook",
      "destination": "/api/saspay?action=webhook"
    },
    {
      "source": "/api/saspay/verify",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/saspay/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/saspay",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/moneroo/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/moneroo",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/notchpay/(.*)",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/notchpay",
      "destination": "/api/saspay"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
