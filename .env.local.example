# ==============================================================================
# Éliciné - Environment Variables Configuration (.env.local.example)
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# AI Search & Embeddings Engine
DEEPSEEK_API_KEY=your-deepseek-api-key
EMBEDDING_MODEL_URL=https://api.your-embedding-provider.com/v1/embeddings
EMBEDDING_API_KEY=your-server-side-embedding-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024
VECTOR_RETRIEVAL_ENABLED=true
STRICT_CONSTRAINT_FILTER_ENABLED=true
ELICINE_RANKING_ENABLED=true

# TMDB Movie Database API
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
