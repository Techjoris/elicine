# Configuration API Éliciné (Serveur / Vercel)
# Ne partagez jamais ces clés publiquement.

# Clé API Groq (utilisée exclusivement côté serveur dans api/groq.js)
GROQ_API_KEY=votre_cle_groq_ici

# Clé API TMDB (utilisée exclusivement côté serveur dans api/tmdb.js)
TMDB_API_KEY=votre_cle_tmdb_ici

# Clé Publique NotchPay (utilisée côté client pour les paiements Mobile Money)
VITE_NOTCHPAY_PUBLIC_KEY=
