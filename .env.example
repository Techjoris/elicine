# ══════════════════════════════════════════════════════════════════════════════
# ÉLICINÉ — Variables d'environnement serveur
# Copiez ce fichier en .env (jamais committé dans Git) et renseignez vos clés.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Moteur IA Principal : Qwen (Alibaba Cloud / DashScope) ───────────────────
# Interrogé en priorité pour les recommandations et analyses cinématographiques
DASHSCOPE_API_KEY=your_qwen_dashscope_key_here
# Noms alternatifs supportés pour la clé Qwen :
# QWEN_API_KEY=...
# VITE_DASHSCOPE_API_KEY=...

# ─── Moteur IA Fallback Haute Disponibilité : DeepSeek (deepseek-flash) ────────
# Utilisé automatiquement en secours immédiat si Qwen échoue ou time out
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# VITE_DEEPSEEK_API_KEY=...

# ─── Moteur IA Secours Supplémentaire : Groq Cloud (Llama 3.3 70B) ─────────────
GROQ_API_KEY=gsk_your_groq_key_here
AI_MODEL=llama-3.3-70b-versatile

# ─── TMDB (The Movie Database — Fallback 2 Absolu & Données Catalogue) ──────
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ─── Moneroo (paiements Afrique & International — Mobile Money & Carte) ──────
MONEROO_SECRET_KEY=your_moneroo_secret_key_here
VITE_MONEROO_SECRET_KEY=your_moneroo_secret_key_here
MONEROO_DEFAULT_CURRENCY=XOF
VITE_MONEROO_DEFAULT_CURRENCY=XOF

# ─── PayPal ──────────────────────────────────────────────────────────────────
# Mode PayPal : 'sandbox' (tests) ou 'live' (production)
# ATTENTION : En mode 'sandbox' ou avec 'sb', PayPal refuse TOUTES les cartes bancaires réelles ("Nous n'avons pas pu enregistrer cette carte").
# Pour prélever 1$ ou faire de vrais paiements par carte, utilisez votre Client ID Live et mettez VITE_PAYPAL_ENV=live.
VITE_PAYPAL_ENV=sandbox
VITE_PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_ID=sb
VITE_PAYPAL_BUSINESS_ID=ivanjoris959@gmail.com
VITE_PAYPAL_ME_USERNAME=

# URLs de retour PayPal à configurer dans votre tableau de bord :
#   Don / café       → https://votre-app.com/?payment=success
#   Abonnement Pro   → https://votre-app.com/?subscription=pro_success

# ─── Liens VPN Affiliés ──────────────────────────────────────────────────────
VITE_NORDVPN_URL=
VITE_SURFSHARK_URL=

# ─── Supabase Authentification & Base de données ────────────────────────────
VITE_SUPABASE_URL=https://xwhrxtzbxvakqjlajjlc.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── APK (Android) ───────────────────────────────────────────────────────────
VITE_APK_DOWNLOAD_URL=/elicine.apk

