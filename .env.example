# ══════════════════════════════════════════════════════════════════════════════
# ÉLICINÉ — Variables d'environnement serveur
# Copiez ce fichier en .env (jamais committé dans Git) et renseignez vos clés.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Moteur IA Principal : Groq Cloud (Llama 3.3 70B & 8B Instant) ──────────
# Moteur Ultra-rapide & Fiable (< 500ms, 0% blocage 401)
GROQ_API_KEY=gsk_your_groq_key_here

# Modèle Groq actif (optionnel — défaut : llama-3.3-70b-versatile)
# Autres options : llama-3.1-8b-instant
AI_MODEL=llama-3.3-70b-versatile

# ─── Moteur IA Fallback 1 : Qwen (Alibaba Cloud / DashScope) ─────────────────
# Utilisé en secours automatique si Groq est indisponible
DASHSCOPE_API_KEY=your_qwen_dashscope_key_here
# Noms alternatifs supportés pour la clé :
# AI_API_KEY=...
# QWEN_API_KEY=...

# ─── TMDB (The Movie Database — Fallback 2 Absolu & Données Catalogue) ──────
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ─── Notch Pay (paiements Afrique — Mobile Money & Carte) ───────────────────
VITE_NOTCHPAY_PUBLIC_KEY=pk_your_notchpay_public_key_here
NOTCHPAY_SECRET_KEY=sk_your_notchpay_secret_key_here
NOTCHPAY_HASH_KEY=your_notchpay_webhook_hash_here

# ─── PayPal ──────────────────────────────────────────────────────────────────
VITE_PAYPAL_BUSINESS_ID=ivanjoris959@gmail.com
VITE_PAYPAL_ME_USERNAME=

# URLs de retour PayPal à configurer dans votre tableau de bord :
#   Don / café       → https://votre-app.com/?payment=success
#   Abonnement Pro   → https://votre-app.com/?subscription=pro_success

# ─── Liens VPN Affiliés ──────────────────────────────────────────────────────
VITE_NORDVPN_URL=
VITE_SURFSHARK_URL=

# ─── APK (Android) ───────────────────────────────────────────────────────────
VITE_APK_DOWNLOAD_URL=/elicine.apk
